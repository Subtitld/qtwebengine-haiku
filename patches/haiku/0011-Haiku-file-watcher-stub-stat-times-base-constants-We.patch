+++ b/src/3rdparty/chromium/third_party/webrtc/rtc_base/physical_socket_server.cc
@@ -9,6 +9,20 @@
  */
 #include "rtc_base/physical_socket_server.h"
 
+#if defined(__HAIKU__)
+// Haiku has none of these options. Numbers it does not know make
+// setsockopt()/getsockopt() fail, which the code below already handles.
+#ifndef IPV6_TCLASS
+#define IPV6_TCLASS 0x7f01
+#endif
+#ifndef SO_TIMESTAMP
+#define SO_TIMESTAMP 0x7f02
+#endif
+#ifndef SCM_TIMESTAMP
+#define SCM_TIMESTAMP SO_TIMESTAMP
+#endif
+#endif
