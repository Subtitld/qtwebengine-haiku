From 8c9d6409f460a5eef21196a8ec1eda1ecfb9c162 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonat=C3=A3=20Bolzan=20Loss?= <jonata@jonata.org>
Date: Wed, 11 Nov 2026 22:39:45 -0300
Subject: [PATCH 05/24] Haiku: Skia, the Vulkan loader and libdrm

Haiku's GCC defines no __unix__, so Skia did not pick SK_BUILD_FOR_UNIX
and fell through to the Mac code. The Vulkan loader counts Haiku as a
common Unix platform and has no executable path to look up. libdrm gets
major/minor/makedev, which Haiku lacks (it has no DRM devices).
---
 src/3rdparty/chromium/third_party/libdrm/BUILD.gn           | 4 +++-
 src/3rdparty/chromium/third_party/libdrm/src/xf86drm.c      | 6 ++++++
 .../third_party/skia/include/private/base/SkFeatures.h      | 3 ++-
 .../vulkan-loader/src/loader/vk_loader_platform.h           | 4 ++--
 4 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/src/3rdparty/chromium/third_party/libdrm/BUILD.gn b/src/3rdparty/chromium/third_party/libdrm/BUILD.gn
index f3a486d..3fdc6fb 100644
--- a/src/3rdparty/chromium/third_party/libdrm/BUILD.gn
+++ b/src/3rdparty/chromium/third_party/libdrm/BUILD.gn
@@ -35,7 +35,9 @@ config("libdrm_config") {
   cflags = [ "-Wno-#pragma-messages" ]
 
   # glibc version >= 2.25 explicitly include <sys/sysmacros.h>
-  cflags += [ "-DMAJOR_IN_SYSMACROS=1" ]
+  if (!is_haiku) {
+    cflags += [ "-DMAJOR_IN_SYSMACROS=1" ]
+  }
 
   # TODO(b/357680612): unused function 'swap32'.
   cflags += [ "-Wno-unused-function" ]
diff --git a/src/3rdparty/chromium/third_party/libdrm/src/xf86drm.c b/src/3rdparty/chromium/third_party/libdrm/src/xf86drm.c
index 5f0eddc..076d2aa 100644
--- a/src/3rdparty/chromium/third_party/libdrm/src/xf86drm.c
+++ b/src/3rdparty/chromium/third_party/libdrm/src/xf86drm.c
@@ -57,6 +57,12 @@
 #ifdef MAJOR_IN_SYSMACROS
 #include <sys/sysmacros.h>
 #endif
+#ifdef __HAIKU__
+/* Haiku has no device numbers to split; there is no DRM device to open. */
+#define major(dev) ((unsigned int)(((dev) >> 8) & 0xfff))
+#define minor(dev) ((unsigned int)((dev) & 0xff))
+#define makedev(maj, min) ((dev_t)(((maj) << 8) | (min)))
+#endif
 #if HAVE_SYS_SYSCTL_H
 #include <sys/sysctl.h>
 #endif
diff --git a/src/3rdparty/chromium/third_party/skia/include/private/base/SkFeatures.h b/src/3rdparty/chromium/third_party/skia/include/private/base/SkFeatures.h
index 2452386..2eefb1f 100644
--- a/src/3rdparty/chromium/third_party/skia/include/private/base/SkFeatures.h
+++ b/src/3rdparty/chromium/third_party/skia/include/private/base/SkFeatures.h
@@ -22,7 +22,8 @@
     #elif defined(linux) || defined(__linux) || defined(__FreeBSD__) || \
           defined(__OpenBSD__) || defined(__sun) || defined(__NetBSD__) || \
           defined(__DragonFly__) || defined(__Fuchsia__) || \
-          defined(__GLIBC__) || defined(__GNU__) || defined(__unix__)
+          defined(__GLIBC__) || defined(__GNU__) || defined(__unix__) || \
+          defined(__HAIKU__)
         #define SK_BUILD_FOR_UNIX
     #elif TARGET_OS_IPHONE || TARGET_IPHONE_SIMULATOR
         #define SK_BUILD_FOR_IOS
diff --git a/src/3rdparty/chromium/third_party/vulkan-loader/src/loader/vk_loader_platform.h b/src/3rdparty/chromium/third_party/vulkan-loader/src/loader/vk_loader_platform.h
index be1b08a..7499189 100644
--- a/src/3rdparty/chromium/third_party/vulkan-loader/src/loader/vk_loader_platform.h
+++ b/src/3rdparty/chromium/third_party/vulkan-loader/src/loader/vk_loader_platform.h
@@ -44,7 +44,7 @@
 
 // Set of platforms with a common set of functionality which is queried throughout the program
 #if defined(__linux__) || defined(__APPLE__) || defined(__Fuchsia__) || defined(__QNX__) || defined(__FreeBSD__) || \
-    defined(__OpenBSD__) || defined(__NetBSD__) || defined(__DragonFly__) || defined(__GNU__)
+    defined(__OpenBSD__) || defined(__NetBSD__) || defined(__DragonFly__) || defined(__GNU__) || defined(__HAIKU__)
 #define COMMON_UNIX_PLATFORMS 1
 #else
 #define COMMON_UNIX_PLATFORMS 0
@@ -361,7 +361,7 @@ static inline char *loader_platform_executable_path(char *buffer, size_t size) {
         buffer = "/usr/local/chrome/chrome";
   return buffer;
 }
-#elif defined(__Fuchsia__)
+#elif defined(__Fuchsia__) || defined(__HAIKU__)
 static inline char *loader_platform_executable_path(char *buffer, size_t size) { return NULL; }
 #elif defined(__QNX__)
 
