From 6536fb46219f84e65de6281f6b72415b09a1977c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonat=C3=A3=20Bolzan=20Loss?= <jonata@jonata.org>
Date: Thu, 12 Nov 2026 02:58:21 -0300
Subject: [PATCH 17/24] Haiku: V8 trap handler header compiles (the handler
 stays off)

---
 .../chromium/v8/src/trap-handler/handler-inside-posix.h       | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/3rdparty/chromium/v8/src/trap-handler/handler-inside-posix.h b/src/3rdparty/chromium/v8/src/trap-handler/handler-inside-posix.h
index ef2f4ee..a177dc9 100644
--- a/src/3rdparty/chromium/v8/src/trap-handler/handler-inside-posix.h
+++ b/src/3rdparty/chromium/v8/src/trap-handler/handler-inside-posix.h
@@ -17,6 +17,10 @@ namespace trap_handler {
 constexpr int kOobSignal = SIGSEGV;
 #elif V8_OS_DARWIN
 constexpr int kOobSignal = SIGBUS;
+#elif V8_OS_HAIKU
+// No trap handler on Haiku (V8_TRAP_HANDLER_SUPPORTED is false); the
+// constant only keeps the declarations below compiling.
+constexpr int kOobSignal = SIGSEGV;
 #else
 #error Posix trap handlers are only supported on Linux, MacOSX and FreeBSD.
 #endif
