From 169bc939bd03ee722cb508730a614536a7645ad0 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonat=C3=A3=20Bolzan=20Loss?= <jonata@jonata.org>
Date: Thu, 12 Nov 2026 02:42:01 -0300
Subject: [PATCH 15/24] Haiku: Blink and ANGLE thread stacks/names, memory
 instrumentation

Blink's stack size and start (used to scan the stack for GC) come from
get_thread_info; ANGLE names threads with rename_thread; the memory
instrumentation service gets os_metrics_haiku.cc, the team's area RAM.
---
 .../cpp/memory_instrumentation/BUILD.gn       |  4 +-
 .../os_metrics_haiku.cc                       | 47 +++++++++++++++++++
 .../angle/src/common/system_utils_linux.cpp   |  8 +++-
 .../blink/renderer/platform/wtf/stack_util.cc | 16 ++++++-
 4 files changed, 72 insertions(+), 3 deletions(-)
 create mode 100644 src/3rdparty/chromium/services/resource_coordinator/public/cpp/memory_instrumentation/os_metrics_haiku.cc

diff --git a/src/3rdparty/chromium/services/resource_coordinator/public/cpp/memory_instrumentation/BUILD.gn b/src/3rdparty/chromium/services/resource_coordinator/public/cpp/memory_instrumentation/BUILD.gn
index d071c41..0cb9cad 100644
--- a/src/3rdparty/chromium/services/resource_coordinator/public/cpp/memory_instrumentation/BUILD.gn
+++ b/src/3rdparty/chromium/services/resource_coordinator/public/cpp/memory_instrumentation/BUILD.gn
@@ -31,7 +31,9 @@ component("memory_instrumentation") {
     sources += [ "os_metrics_linux.cc" ]
   }
 
-  if (is_bsd) {
+  if (is_haiku) {
+    sources += [ "os_metrics_haiku.cc" ]
+  } else if (is_bsd) {
     sources += [ "os_metrics_bsd.cc" ]
   }
 
diff --git a/src/3rdparty/chromium/services/resource_coordinator/public/cpp/memory_instrumentation/os_metrics_haiku.cc b/src/3rdparty/chromium/services/resource_coordinator/public/cpp/memory_instrumentation/os_metrics_haiku.cc
new file mode 100644
index 0000000..0b68f57
--- /dev/null
+++ b/src/3rdparty/chromium/services/resource_coordinator/public/cpp/memory_instrumentation/os_metrics_haiku.cc
@@ -0,0 +1,47 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "services/resource_coordinator/public/cpp/memory_instrumentation/os_metrics.h"
+
+#include <OS.h>
+
+#include <vector>
+
+#include "base/notreached.h"
+#include "base/process/process.h"
+
+namespace memory_instrumentation {
+
+// static
+bool OSMetrics::FillOSMemoryDump(base::ProcessId pid,
+                                 mojom::RawOSMemDump* dump) {
+  const team_id team =
+      pid == base::kNullProcessId ? B_CURRENT_TEAM : static_cast<team_id>(pid);
+  // The RAM behind the team's areas is its resident set.
+  uint64_t resident = 0;
+  area_info area;
+  ssize_t cookie = 0;
+  bool any = false;
+  while (get_next_area_info(team, &cookie, &area) == B_OK) {
+    resident += area.ram_size;
+    any = true;
+  }
+  if (!any) {
+    return false;
+  }
+
+  dump->resident_set_kb = static_cast<uint32_t>(resident / 1024);
+  dump->platform_private_footprint->rss_anon_bytes = resident;
+  dump->platform_private_footprint->vm_swap_bytes = 0;
+  return true;
+}
+
+// static
+std::vector<mojom::VmRegionPtr> OSMetrics::GetProcessMemoryMaps(
+    base::ProcessId) {
+  NOTIMPLEMENTED();
+  return std::vector<mojom::VmRegionPtr>();
+}
+
+}  // namespace memory_instrumentation
diff --git a/src/3rdparty/chromium/third_party/angle/src/common/system_utils_linux.cpp b/src/3rdparty/chromium/third_party/angle/src/common/system_utils_linux.cpp
index 856d0b7..f61f86e 100644
--- a/src/3rdparty/chromium/third_party/angle/src/common/system_utils_linux.cpp
+++ b/src/3rdparty/chromium/third_party/angle/src/common/system_utils_linux.cpp
@@ -19,6 +19,10 @@
 #include <pthread_np.h>
 #endif
 
+#if defined(__HAIKU__)
+#include <OS.h>
+#endif
+
 #include <array>
 
 namespace angle
@@ -65,7 +69,9 @@ void SetCurrentThreadName(const char *name)
     // There's a 15-character (16 including '\0') limit.  If the name is too big (and ERANGE is
     // returned), name will be ignored.
     ASSERT(strlen(name) < 16);
-#if ANGLE_PLATFORM_OPENBSD
+#if defined(__HAIKU__)
+    rename_thread(find_thread(nullptr), name);
+#elif ANGLE_PLATFORM_OPENBSD
     pthread_set_name_np(pthread_self(), name);
 #else
     pthread_setname_np(pthread_self(), name);
diff --git a/src/3rdparty/chromium/third_party/blink/renderer/platform/wtf/stack_util.cc b/src/3rdparty/chromium/third_party/blink/renderer/platform/wtf/stack_util.cc
index 36461af..f1533d2 100644
--- a/src/3rdparty/chromium/third_party/blink/renderer/platform/wtf/stack_util.cc
+++ b/src/3rdparty/chromium/third_party/blink/renderer/platform/wtf/stack_util.cc
@@ -23,7 +23,9 @@
 extern "C" void* __libc_stack_end;  // NOLINT
 #endif
 
-#if BUILDFLAG(IS_BSD)
+#if BUILDFLAG(IS_HAIKU)
+#include <OS.h>
+#elif BUILDFLAG(IS_BSD)
 #include <sys/signal.h>
 #include <pthread_np.h>
 #endif
@@ -72,6 +74,13 @@ size_t GetUnderestimatedStackSize() {
   //    low as 512k.
   //
   return 512 * 1024;
+#elif BUILDFLAG(IS_HAIKU)
+  thread_info info;
+  if (get_thread_info(find_thread(nullptr), &info) != B_OK) {
+    return 512 * 1024;
+  }
+  return static_cast<uint8_t*>(info.stack_end) -
+         static_cast<uint8_t*>(info.stack_base);
 #elif BUILDFLAG(IS_OPENBSD)
   return 512 * 1024;
 #elif BUILDFLAG(IS_APPLE)
@@ -140,6 +149,11 @@ void* GetStackStart() {
   NOTREACHED() << "pthread_getattr_np() failed for stack end and no "
                   "glibc __libc_stack_end is present.";
 #endif
+#elif BUILDFLAG(IS_HAIKU)
+  // Stacks grow down: the start is the highest address.
+  thread_info info;
+  CHECK_EQ(get_thread_info(find_thread(nullptr), &info), B_OK);
+  return info.stack_end;
 #elif BUILDFLAG(IS_APPLE)
   return pthread_get_stackaddr_np(pthread_self());
 #elif BUILDFLAG(IS_WIN) && defined(COMPILER_MSVC)
