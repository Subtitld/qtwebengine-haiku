From 548c6065c8061345ddda49ecc232ac529a867ef0 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonat=C3=A3=20Bolzan=20Loss?= <jonata@jonata.org>
Date: Thu, 12 Nov 2026 01:26:30 -0300
Subject: [PATCH 12/24] Haiku: base/ thread ids are kernel thread ids
 (find_thread)

---
 .../chromium/base/threading/platform_thread_posix.cc       | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/3rdparty/chromium/base/threading/platform_thread_posix.cc b/src/3rdparty/chromium/base/threading/platform_thread_posix.cc
index be1af8e..f67d89c 100644
--- a/src/3rdparty/chromium/base/threading/platform_thread_posix.cc
+++ b/src/3rdparty/chromium/base/threading/platform_thread_posix.cc
@@ -32,6 +32,10 @@
 #include "base/posix/can_lower_nice_to.h"
 #endif
 
+#if BUILDFLAG(IS_HAIKU)
+#include <OS.h>
+#endif
+
 #if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
 #include <sys/syscall.h>
 
@@ -270,6 +274,9 @@ PlatformThreadId PlatformThreadBase::CurrentId() {
   return reinterpret_cast<int32_t>(pthread_self());
 #elif BUILDFLAG(IS_POSIX) && BUILDFLAG(IS_AIX)
   return pthread_self();
+#elif BUILDFLAG(IS_HAIKU)
+  // A kernel thread id, unique across the system, unlike pthread_self().
+  return static_cast<uint64_t>(find_thread(nullptr));
 #elif BUILDFLAG(IS_BSD)
   return reinterpret_cast<uint64_t>(pthread_self());
 #elif BUILDFLAG(IS_POSIX) && !BUILDFLAG(IS_AIX)
