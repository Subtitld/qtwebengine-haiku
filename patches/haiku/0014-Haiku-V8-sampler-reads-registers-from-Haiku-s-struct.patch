From 006e652a76b4ef23bb734ade7da1afc370324c35 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonat=C3=A3=20Bolzan=20Loss?= <jonata@jonata.org>
Date: Thu, 12 Nov 2026 02:29:03 -0300
Subject: [PATCH 14/31] Haiku: V8 sampler reads registers from Haiku's struct
 vregs

---
 src/3rdparty/chromium/v8/src/libsampler/sampler.cc | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/src/3rdparty/chromium/v8/src/libsampler/sampler.cc b/src/3rdparty/chromium/v8/src/libsampler/sampler.cc
index 88884fa..b8875c8 100644
--- a/src/3rdparty/chromium/v8/src/libsampler/sampler.cc
+++ b/src/3rdparty/chromium/v8/src/libsampler/sampler.cc
@@ -16,7 +16,7 @@
 #include <sys/time.h>
 #include <atomic>
 
-#if !V8_OS_QNX && !V8_OS_AIX && !V8_OS_ZOS
+#if !V8_OS_QNX && !V8_OS_AIX && !V8_OS_ZOS && !V8_OS_HAIKU
 #include <sys/syscall.h>
 #endif
 
@@ -489,6 +489,13 @@ void SignalHandler::FillRegisterState(void* context, RegisterState* state) {
 #error Unexpected iOS target architecture.
 #endif  // V8_TARGET_ARCH_ARM64
 
+#elif V8_OS_HAIKU
+#if V8_HOST_ARCH_X64
+  // Haiku's mcontext_t is struct vregs.
+  state->pc = reinterpret_cast<void*>(mcontext.rip);
+  state->sp = reinterpret_cast<void*>(mcontext.rsp);
+  state->fp = reinterpret_cast<void*>(mcontext.rbp);
+#endif  // V8_HOST_ARCH_X64
 #elif V8_OS_DARWIN
 #if V8_HOST_ARCH_X64
   state->pc = reinterpret_cast<void*>(mcontext->__ss.__rip);
