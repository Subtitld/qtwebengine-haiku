@@ -3,6 +3,7 @@
 // found in the LICENSE file.
 
 import terser from '@rollup/plugin-terser';
+import {cpus} from 'node:os';
 
 /**
  * Checks if an env variable is true.
@@ -17,5 +18,5 @@ function isEnvVarTrue(envVar) {
 export default {
   treeshake: true,
   output: [{format: 'iife'}],
-  plugins: isEnvVarTrue(process.env.DEBUG_INJECTED) ? [] : [terser()]
+  plugins: isEnvVarTrue(process.env.DEBUG_INJECTED) ? [] : [terser({maxWorkers: cpus().length || 4})]
 };
