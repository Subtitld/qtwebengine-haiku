diff --git a/src/3rdparty/chromium/third_party/devtools-frontend/src/front_end/models/live-metrics/web-vitals-injected/rollup.config.mjs b/src/3rdparty/chromium/third_party/devtools-frontend/src/front_end/models/live-metrics/web-vitals-injected/rollup.config.mjs
