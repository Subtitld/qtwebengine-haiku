From 2506c22853f2cd06fb14e15d1622c8353e1db80d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonat=C3=A3=20Bolzan=20Loss?= <jonata@jonata.org>
Date: Wed, 11 Nov 2026 22:21:49 -0300
Subject: [PATCH 02/31] Haiku: gn gen passes; first build fixes

nasm: no /usr/include/string.h to probe (and no mempcpy).
devtools-frontend: Node lists no CPUs on Haiku, so terser got no workers
and rollup never finished; give it a worker count.
perfetto: Haiku takes the Linux/BSD branch of build_config.h.
---
 .../src/scripts/build/rollup.config.mjs             |  5 ++++-
 src/3rdparty/chromium/third_party/nasm/BUILD.gn     | 13 ++++++++-----
 .../perfetto/include/perfetto/base/build_config.h   |  3 ++-
 3 files changed, 14 insertions(+), 7 deletions(-)

diff --git a/src/3rdparty/chromium/third_party/devtools-frontend/src/scripts/build/rollup.config.mjs b/src/3rdparty/chromium/third_party/devtools-frontend/src/scripts/build/rollup.config.mjs
index 3cf10ad..18e41a9 100644
--- a/src/3rdparty/chromium/third_party/devtools-frontend/src/scripts/build/rollup.config.mjs
+++ b/src/3rdparty/chromium/third_party/devtools-frontend/src/scripts/build/rollup.config.mjs
@@ -5,6 +5,7 @@
 // @ts-check
 
 import terser from '@rollup/plugin-terser';
+import {cpus} from 'node:os';
 import sourcemaps from 'rollup-plugin-sourcemaps2';
 
 import { devtoolsPlugin } from './devtools_plugin.js';
@@ -19,7 +20,9 @@ export default commandLineArgs => ({
     sourcemap: Boolean(commandLineArgs.configSourcemaps),
   }],
   plugins: [
-    terser(),
+    // Node on Haiku lists no CPUs, which leaves terser with no workers to
+    // run on and rollup waiting for ever.
+    terser({maxWorkers: cpus().length || 4}),
     {
       name: 'devtools-plugin',
       resolveId(source, importer) {
diff --git a/src/3rdparty/chromium/third_party/nasm/BUILD.gn b/src/3rdparty/chromium/third_party/nasm/BUILD.gn
index 302123f..2679f518 100644
--- a/src/3rdparty/chromium/third_party/nasm/BUILD.gn
+++ b/src/3rdparty/chromium/third_party/nasm/BUILD.gn
@@ -63,11 +63,14 @@ config("nasm_config") {
 
   defines = [ "HAVE_CONFIG_H" ]
 
-  _string_h_lines =
-        read_file("/usr/include/string.h", "list lines")
-  _mempcpy = filter_include(_string_h_lines, [ "*mempcpy*" ])
-  if (_mempcpy != []) {
-    defines += [ "HAVE_MEMPCPY=1" ]
+  # Haiku has no /usr/include, and no mempcpy either.
+  if (!is_haiku) {
+    _string_h_lines =
+          read_file("/usr/include/string.h", "list lines")
+    _mempcpy = filter_include(_string_h_lines, [ "*mempcpy*" ])
+    if (_mempcpy != []) {
+      defines += [ "HAVE_MEMPCPY=1" ]
+    }
   }
 
   if (is_clang) {
diff --git a/src/3rdparty/chromium/third_party/perfetto/include/perfetto/base/build_config.h b/src/3rdparty/chromium/third_party/perfetto/include/perfetto/base/build_config.h
index c08c206..cb324df 100644
--- a/src/3rdparty/chromium/third_party/perfetto/include/perfetto/base/build_config.h
+++ b/src/3rdparty/chromium/third_party/perfetto/include/perfetto/base/build_config.h
@@ -57,7 +57,8 @@
 #define PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_MAC() 1
 #define PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_IOS() 0
 #endif
-#elif defined(__linux__) || defined(__OpenBSD__) || defined(__FreeBSD__)
+#elif defined(__linux__) || defined(__OpenBSD__) || defined(__FreeBSD__) || \
+    defined(__HAIKU__)
 #define PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_ANDROID() 0
 #define PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_LINUX() 1
 #define PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_BSD() 1
