Subject: [PATCH 27/31] content: the file system access watcher is the stub on
 Haiku (no EVFILT_VNODE)

---
 src/3rdparty/chromium/content/browser/BUILD.gn | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/3rdparty/chromium/content/browser/BUILD.gn b/src/3rdparty/chromium/content/browser/BUILD.gn
index 906df00..ec35c7a 100644
--- a/src/3rdparty/chromium/content/browser/BUILD.gn
+++ b/src/3rdparty/chromium/content/browser/BUILD.gn
@@ -2529,7 +2529,8 @@ jumbo_source_set("browser") {
     ]
   }
 
-  if (is_bsd) {
+  # Haiku's kqueue has no EVFILT_VNODE: it keeps the stub.
+  if (is_bsd && !is_haiku) {
     sources += [
       "file_system_access/file_path_watcher/file_path_watcher_bsd.cc",
       "file_system_access/file_path_watcher/file_path_watcher_kqueue.cc",
@@ -2592,6 +2593,10 @@ jumbo_source_set("browser") {
       "sandbox_ipc_linux.h",
     ]
   }
+  if (is_haiku) {
+    sources +=
+        [ "file_system_access/file_path_watcher/file_path_watcher_stub.cc" ]
+  }
 
   if (is_chromeos) {
     sources += [
