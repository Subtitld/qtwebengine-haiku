From 6c3cc9a6ba90216cf4de733abeb9444fda5dd738 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonat=C3=A3=20Bolzan=20Loss?= <jonata@jonata.org>
Date: Fri, 13 Nov 2026 04:34:36 -0300
Subject: [PATCH 31/31] net: AddressSorterPosix skips interfaces without an
 address (Haiku lists them)

---
 src/3rdparty/chromium/net/dns/address_sorter_posix.cc | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/3rdparty/chromium/net/dns/address_sorter_posix.cc b/src/3rdparty/chromium/net/dns/address_sorter_posix.cc
index 5cee5b3..cb56fa9 100644
--- a/src/3rdparty/chromium/net/dns/address_sorter_posix.cc
+++ b/src/3rdparty/chromium/net/dns/address_sorter_posix.cc
@@ -438,6 +438,9 @@ void AddressSorterPosix::OnIPAddressChanged() {
   }
 
   for (struct ifaddrs* ifa = addrs; ifa != nullptr; ifa = ifa->ifa_next) {
+    // Haiku lists interfaces without an address too.
+    if (!ifa->ifa_addr)
+      continue;
     IPEndPoint src;
     if (!src.FromSockAddr(ifa->ifa_addr, ifa->ifa_addr->sa_len))
       continue;
