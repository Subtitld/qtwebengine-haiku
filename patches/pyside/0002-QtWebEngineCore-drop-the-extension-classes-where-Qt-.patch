From b86eabff0070066b641f42bd7abef77017024983 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonat=C3=A3=20Bolzan=20Loss?= <jbopen@gmail.com>
Date: Fri, 13 Nov 2026 10:35:29 -0300
Subject: [PATCH 2/2] QtWebEngineCore: drop the extension classes where Qt has
 none

A QtWebEngine built without the webengine_extensions feature has no
QWebEngineExtensionInfo or QWebEngineExtensionManager, as QtNetwork
drops its SSL classes without ssl.
---
 .../PySide6/QtWebEngineCore/CMakeLists.txt     | 18 +++++++++++++++---
 1 file changed, 15 insertions(+), 3 deletions(-)

diff --git a/sources/pyside6/PySide6/QtWebEngineCore/CMakeLists.txt b/sources/pyside6/PySide6/QtWebEngineCore/CMakeLists.txt
index 4d93443..12ef13e 100644
--- a/sources/pyside6/PySide6/QtWebEngineCore/CMakeLists.txt
+++ b/sources/pyside6/PySide6/QtWebEngineCore/CMakeLists.txt
@@ -20,8 +20,6 @@ ${QtWebEngineCore_GEN_DIR}/qwebenginecookiestore_wrapper.cpp
 ${QtWebEngineCore_GEN_DIR}/qwebenginecookiestore_filterrequest_wrapper.cpp
 ${QtWebEngineCore_GEN_DIR}/qwebenginedesktopmediarequest_wrapper.cpp
 ${QtWebEngineCore_GEN_DIR}/qwebenginedownloadrequest_wrapper.cpp
-${QtWebEngineCore_GEN_DIR}/qwebengineextensioninfo_wrapper.cpp
-${QtWebEngineCore_GEN_DIR}/qwebengineextensionmanager_wrapper.cpp
 ${QtWebEngineCore_GEN_DIR}/qwebenginefilesystemaccessrequest_wrapper.cpp
 ${QtWebEngineCore_GEN_DIR}/qwebenginefindtextresult_wrapper.cpp
 ${QtWebEngineCore_GEN_DIR}/qwebengineframe_wrapper.cpp
@@ -73,6 +71,19 @@ set(QtWebEngineCore_include_dirs
                             ${QtPrintSupport_GEN_DIR}
                             ${QtWebChannel_GEN_DIR})
 
+set(QtWebEngineCore_DROPPED_ENTRIES )
+get_property(QtWebEngineCore_disabled_features TARGET Qt${QT_MAJOR_VERSION}::WebEngineCore
+             PROPERTY QT_DISABLED_PUBLIC_FEATURES)
+if("webengine_extensions" IN_LIST QtWebEngineCore_disabled_features)
+    list(APPEND QtWebEngineCore_DROPPED_ENTRIES QWebEngineExtensionInfo
+         QWebEngineExtensionManager)
+    message(STATUS "Qt${QT_MAJOR_VERSION}WebEngineCore: Dropping extension classes")
+else()
+    list(APPEND QtWebEngineCore_SRC
+         ${QtWebEngineCore_GEN_DIR}/qwebengineextensioninfo_wrapper.cpp
+         ${QtWebEngineCore_GEN_DIR}/qwebengineextensionmanager_wrapper.cpp)
+endif()
+
 set(QtWebEngineCore_libraries pyside6
                               ${Qt${QT_MAJOR_VERSION}WebEngineCore_LIBRARIES})
 
@@ -84,4 +95,5 @@ create_pyside_module(NAME QtWebEngineCore
                      LIBRARIES QtWebEngineCore_libraries
                      DEPS QtWebEngineCore_deps
                      TYPESYSTEM_PATH QtWebEngineCore_SOURCE_DIR
-                     SOURCES QtWebEngineCore_SRC)
+                     SOURCES QtWebEngineCore_SRC
+                     DROPPED_ENTRIES QtWebEngineCore_DROPPED_ENTRIES)
